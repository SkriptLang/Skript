# Persistence test for this Skript build. Install in plugins/Skript/scripts/.
# Commands require a player with skript.persistence.test (operators by default).
# All saved data is confined to {persistprobe::*}. One tester at a time.
# Nothing is seeded or reset automatically on script/server load.
#
# BASIC RESTART TEST (repeat independently for MySQL, SQLite and CSV):
#   1. Configure databases: entries to route persistprobe::* to ONE backend and start the server.
#      For MySQL, select a fresh custom table; verify its name in the database.
#   2. /persistprobe seed
#   3. /persistprobe check 1
#   4. Fully stop/start the server; /persistprobe check 1 (DO NOT seed again).
#   5. /persistprobe update
#   6. Fully stop/start; /persistprobe check 2
#   7. /persistprobe delete
#   8. Fully stop/start; /persistprobe empty
#
# MYSQL OUTAGE / JOURNAL TEST (type: MySQL under databases:):
#   1. /persistprobe seed, then stop/start and /persistprobe check 1.
#   2. Stop MySQL externally; /persistprobe update.
#   3a. Restore MySQL, allow retries to finish, stop/start Minecraft, check 2.
#   3b. Alternatively stop Minecraft BEFORE restoring MySQL. Restore MySQL,
#       start Minecraft, then check 2 to verify shutdown journal recovery.
#   Run 3a and 3b as separate experiments, seeding stage 1 each time.
#   Repeat using /persistprobe delete during the outage and /persistprobe empty.
#   A check before restarting only tests memory, NOT durable storage.
#
# EXTRA TESTS:
#   /persistprobe snapshot  - saves each player inventory slot as an item.
#   Restart and /persistprobe snapshotcheck with the SAME player, unchanged
#   inventory. Includes equipment/offhand slots 36..40; does not restore items.
#   /persistprobe syntax    - banner item patterns and wind-charge comparison.
#   /persistprobe check 1   - also tests saved inventory OBJECT diagnostics.
#   Current Inventory ClassInfo has no serializer: expect those diagnostics to
#   fail after restart until inventory-object persistence is implemented.

function persistprobe_assert(ok: boolean, label: text, p: player) :: number:
	if {_ok} is true:
		send "&aPASS &7%{_label}%" to {_p}
		return 0
	send "&cFAIL &7%{_label}%" to {_p}
	return 1

command /persistprobe <text> [<integer>]:
	trigger:
		if arg-1 is "seed":
			delete {persistprobe::*}
			set {persistprobe::stage} to 1
			set {persistprobe::text} to "stage-1 玩家😀"
			set {persistprobe::number} to 42
			set {persistprobe::item} to 3 diamonds named "Saved item marker"
			set {persistprobe::decimal} to 12.5
			set {persistprobe::boolean} to true
			set {persistprobe::vector} to vector(1, 2, 3)
			set {persistprobe::worldname} to name of world of player
			set {persistprobe::world} to world of player
			set {persistprobe::location} to location(12.5, 80, -34.5, world of player, 90, 15)
			set {persistprobe::list::1} to "first"
			set {persistprobe::list::2} to "second"
			set {persistprobe::list::3} to vector(1, 2, 3)
			set {persistprobe::remove-me} to "must disappear at stage 2"
			set {persistprobe::remove-list::1} to "one"
			set {persistprobe::remove-list::2} to "two"
			set {_inventory} to chest inventory with 1 row named "Persistence probe"
			set slot 0 of {_inventory} to 3 diamonds
			set slot 8 of {_inventory} to a stone named "Inventory marker"
			set {persistprobe::inventory-object} to {_inventory}
			set {persistprobe::player-inventory-object} to inventory of player
			send "&eSeeded stage 1. Run /persistprobe check 1, then fully stop/start and check 1 again."
			stop

		if arg-1 is "update":
			if {persistprobe::stage} is not 1:
				send "&cStart from a verified stage 1 before updating."
				stop
			set {persistprobe::stage} to 2
			set {persistprobe::text} to "stage-2 玩家😀"
			set {persistprobe::number} to 84
			set {persistprobe::boolean} to false
			set {persistprobe::list::1} to "updated"
			delete {persistprobe::remove-me}
			delete {persistprobe::remove-list::*}
			send "&eUpdated to stage 2, including single/list deletions. After recovery and restart: /persistprobe check 2"
			stop

		if arg-1 is "check":
			if arg-2 is not 1 or 2:
				send "&cUse /persistprobe check 1 or /persistprobe check 2. Supply the expected stage yourself."
				stop
			set {_stage} to arg-2
			set {_fails} to 0
			add persistprobe_assert(whether {persistprobe::stage} is {_stage}, "expected stage %{_stage}%", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::text} is "stage-%{_stage}% 玩家😀", "Unicode text", player) to {_fails}
			set {_number} to 42 * {_stage}
			add persistprobe_assert(whether {persistprobe::number} is {_number}, "number overwrite", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::decimal} is 12.5, "decimal", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::item} is 3 diamonds, "saved item", player) to {_fails}
			add persistprobe_assert(whether item amount of {persistprobe::item} is 3, "saved item amount", player) to {_fails}
			add persistprobe_assert(whether name of {persistprobe::item} is "Saved item marker", "saved item name", player) to {_fails}
			set {_boolean} to true
			set {_first} to "first"
			if {_stage} is 2:
				set {_boolean} to false
				set {_first} to "updated"
			add persistprobe_assert(whether {persistprobe::boolean} is {_boolean}, "boolean including false", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::vector} is vector(1, 2, 3), "vector", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::worldname} is set, "saved world name", player) to {_fails}
			set {_world} to {persistprobe::worldname} parsed as world
			add persistprobe_assert(whether {_world} is set, "world available after restart", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::world} is {_world}, "world reference", player) to {_fails}
			set {_location} to location(12.5, 80, -34.5, {_world}, 90, 15)
			add persistprobe_assert(whether {persistprobe::location} is {_location}, "location", player) to {_fails}
			add persistprobe_assert(whether yaw of {persistprobe::location} is 90, "location yaw", player) to {_fails}
			add persistprobe_assert(whether pitch of {persistprobe::location} is 15, "location pitch", player) to {_fails}
			add persistprobe_assert(whether size of {persistprobe::list::*} is 3, "list size", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::list::1} is {_first}, "list overwrite", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::list::2} is "second", "list text", player) to {_fails}
			add persistprobe_assert(whether {persistprobe::list::3} is vector(1, 2, 3), "list vector", player) to {_fails}
			if {_stage} is 1:
				add persistprobe_assert(whether {persistprobe::remove-me} is set, "single deletion fixture exists", player) to {_fails}
				add persistprobe_assert(whether size of {persistprobe::remove-list::*} is 2, "list deletion fixture exists", player) to {_fails}
			else:
				add persistprobe_assert(whether {persistprobe::remove-me} is not set, "single deletion persisted", player) to {_fails}
				add persistprobe_assert(whether size of {persistprobe::remove-list::*} is 0, "whole-list deletion persisted", player) to {_fails}
			send "&eCore checks: %{_fails}% failure(s). Only a check after full restart verifies persistence."
			send "&eInventory OBJECT diagnostics (currently unsupported; separate from core checks):"
			set {_ignored} to persistprobe_assert(whether {persistprobe::inventory-object} is set, "chest inventory object restored", player)
			if {persistprobe::inventory-object} is set:
				set {_ignored} to persistprobe_assert(whether slot 0 of {persistprobe::inventory-object} is 3 diamonds, "inventory contents", player)
				set {_ignored} to persistprobe_assert(whether name of slot 8 of {persistprobe::inventory-object} is "Inventory marker", "inventory item name", player)
			set {_ignored} to persistprobe_assert(whether {persistprobe::player-inventory-object} is set, "player inventory object restored", player)
			stop

		if arg-1 is "snapshot":
			delete {persistprobe::snapshot::*}
			set {persistprobe::snapshot-owner} to "%uuid of player%"
			loop 41 times:
				set {_slot} to loop-number - 1
				set {persistprobe::snapshot::%{_slot}%} to slot {_slot} of player's inventory
			send "&eSaved 41 player slots as individual items. Restart without changing inventory, then /persistprobe snapshotcheck."
			stop

		if arg-1 is "snapshotcheck":
			if {persistprobe::snapshot-owner} is not "%uuid of player%":
				send "&cNo snapshot for this player. Run snapshot before restarting."
				stop
			set {_fails} to 0
			loop 41 times:
				set {_slot} to loop-number - 1
				set {_expected} to slot {_slot} of player's inventory
				if {_expected} is air:
					if {persistprobe::snapshot::%{_slot}%} is not set:
						continue
				add persistprobe_assert(whether {persistprobe::snapshot::%{_slot}%} is {_expected}, "player snapshot slot %{_slot}%", player) to {_fails}
			send "&ePlayer contents snapshot: %{_fails}% failure(s). Live inventory is the comparison reference."
			stop

		if arg-1 is "syntax":
			set {_fails} to 0
			set {_banner} to a white standing banner
			set {_pattern} to a creeper banner pattern colored red
			add {_pattern} to banner patterns of {_banner}
			add persistprobe_assert(whether banner patterns of {_banner} contains {_pattern}, "banner pattern added", player) to {_fails}
			remove {_pattern} from banner patterns of {_banner}
			add persistprobe_assert(whether banner patterns of {_banner} does not contain {_pattern}, "banner pattern removed", player) to {_fails}
			# Remove immediately, before the projectile can tick or hit anything.
			spawn a wind charge at location of player ~ vector(0, 10, 0):
				set {_charge} to entity
			add persistprobe_assert(whether {_charge} is a wind charge, "wind-charge item/entity alias", player) to {_fails}
			delete {_charge}
			send "&eSyntax checks: %{_fails}% failure(s)."
			stop

		if arg-1 is "delete":
			delete {persistprobe::*}
			send "&eDeleted all persistprobe variables. Restart, then /persistprobe empty."
			stop
		if arg-1 is "empty":
			set {_ignored} to persistprobe_assert(whether size of {persistprobe::*} is 0, "all test variables remain deleted", player)
			stop
		send "&e/persistprobe seed | check <1 or 2> | update | snapshot | snapshotcheck | syntax | delete | empty"