test "world names and villager professions used by persistence probes":
	set {_world} to first element of all worlds
	assert {_world} is set
	set {_name} to name of {_world}
	assert {_name} is set with "world name expression returned nothing"
	set {_resolved} to {_name} parsed as world
	assert {_resolved} is {_world} with "world name did not resolve"
	set {_profession} to farmer profession
	assert {_profession} is set with "farmer profession returned nothing"
	assert {_profession} is farmer profession with "profession comparison failed"
	set {_directName} to name of world of spawn point of {_world}
	assert {_directName} is set with "statically typed world name returned nothing"
	assert {_directName} is {_name} with "typed and variable world names differ"
	set {world-profession-regression::name} to name of world of spawn point of {_world}
	assert {world-profession-regression::name} is set with "global world name was not stored"
	set {_storedWorld} to {world-profession-regression::name} parsed as world
	assert {_storedWorld} is {_world} with "stored world name did not resolve"
	delete {world-profession-regression::*}
